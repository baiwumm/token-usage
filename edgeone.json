{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:landing:deploy",
  "outputDirectory": "apps/landing/out",
  "nodeVersion": "22.11.0",
  "redirects": [
    {
      "source": "$wwwhost",
      "destination": "$host",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/_next/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

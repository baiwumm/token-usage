# Token Usage — environment template (apps/web)
# Copy to apps/web/.env.local for local dev, or set these in Vercel.
# Values are EXAMPLES — never commit real keys.

# Supabase project (new sb_publishable_/sb_secret_ key system; legacy
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY accepted as fallbacks).
# Where to find these: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Public base URL of THIS deployment. The CLI pairing flow hands it out as
# the /device verification URL. Must match the deployed origin.
TOKEN_USAGE_DASHBOARD_URL=https://token-usage.your-domain.com

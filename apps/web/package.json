		"@number-flow/react": "^0.6.2",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.0",
		"intl-messageformat": "12.1.5",
		"motion": "^14.14.0",
		"next": "16.4.6",
		"next-themes": "0.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-easy-crop": "6.2.5",
		"recharts": "^3.10.1",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@next/eslint-plugin-next": "16.4.6",
		"@tailwindcss/postcss": "4.3.5",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/eslint-plugin": "8.72.2",
		"@typescript-eslint/parser": "8.72.2",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.14.0",
		"postcss": "8.5.33",
		"prettier": "3.10.1",
		"tailwindcss": "4.3.5",

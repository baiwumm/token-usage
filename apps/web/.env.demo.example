# Demo instance env — LOCAL TEMPLATE (safe to commit: no real values here).
#
#   cp apps/web/.env.demo.example apps/web/.env.demo.local
#
# `.env.demo.local` is gitignored (.env*.local). It is read by
# scripts/demo/seed.mjs, which refuses to touch a generic `.env.local` because
# that file holds the operator's PRODUCTION instance values.
#
# The same values go into two more places (see docs/demo-instance.md):
#   - the demo Vercel project's environment variables
#   - GitHub Actions secrets for the nightly reseed
# Never point any of these at the production Supabase project.

# Supabase → Project Settings → API (the DEMO project).
NEXT_PUBLIC_SUPABASE_URL=https://your-demo-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Demo gate + the shared read-only account (server-side only).
TOKEN_USAGE_DEMO=on
TOKEN_USAGE_DEMO_EMAIL=demo@token-usage.cc
TOKEN_USAGE_DEMO_PASSWORD=

# Public origin of the demo deployment (also the printed /u/ link prefix).
TOKEN_USAGE_DASHBOARD_URL=https://demo.token-usage.cc

# Vercel installs this app with npm (no lockfile inside apps/web — the pnpm
# lockfile lives at the repo root, which Vercel's detection does not pick up
# from a nested Root Directory). npm's strict peer check rejects the
# eslint@10 × eslint-plugin-import@2 (peers declare up to ^9) pair that the
# repo intentionally runs; legacy-peer-deps restores npm's classic
# non-strict resolution, matching what pnpm does in dev and CI.
legacy-peer-deps=true

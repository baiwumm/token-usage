{
	"name": "@token-usage/landing",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"description": "Token Usage — official website and documentation, statically exported and deployed on Tencent EdgeOne.",
	"license": "MIT",
	"author": {
		"name": "baiwumm",
		"url": "https://github.com/baiwumm"
	},
	"homepage": "https://www.token-usage.cc",
	"keywords": [
		"token-usage",
		"documentation",
		"landing",
		"nextjs",
		"fumadocs",
		"static-site",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/baiwumm/token-usage.git",
		"directory": "apps/landing"
	},
	"bugs": {
		"url": "https://github.com/baiwumm/token-usage/issues"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"build:deploy": "pnpm sync:snapshot && next build",
		"sync:snapshot": "node scripts/sync-snapshot.mjs",
		"start": "next start",
		"lint": "eslint --fix",
		"postinstall": "fumadocs-mdx",
		"clean:.next": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
		"clean:out": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
		"verify": "pnpm clean:.next && pnpm clean:out && pnpm lint && pnpm exec tsc --noEmit && pnpm build"
	},
	"dependencies": {
		"@gravity-ui/icons": "^2.23.1",
		"@heroui/react": "3.2.7",
		"@heroui/styles": "3.2.7",
		"@number-flow/react": "^0.6.2",
		"clsx": "2.1.1",
		"fumadocs-core": "16.19.3",
		"fumadocs-mdx": "15.6.2",
		"fumadocs-ui": "16.19.3",
		"next": "16.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@next/eslint-plugin-next": "16.4.6",
		"@tailwindcss/postcss": "4.3.5",
		"@types/mdx": "2.0.14",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/eslint-plugin": "8.72.2",
		"@typescript-eslint/parser": "8.72.2",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.14.0",
		"postcss": "8.5.33",
		"prettier": "3.10.1",
		"tailwindcss": "4.3.5",
		"typescript": "5.9.3"
	}
}

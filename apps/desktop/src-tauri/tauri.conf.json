{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Usage",
  "version": "0.4.0",
  "identifier": "cc.token-usage.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Token Usage",
        "width": 400,
        "height": 620,
        "minWidth": 340,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhERTM1RjRFNjlCMkY5NDUKUldSRitiSnBUbC9qalo0WkJDcjdUMU9iQTB1cnM4TzZRQysrcjBOMnI3Z0g1N1ZtaW1QQllSenQK",
      "endpoints": [
        "https://github.com/baiwumm/token-usage/releases/download/desktop-latest/latest.json"
      ]
    }
  }
}

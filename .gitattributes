# Normalize line endings (拍板项 2, 2026-10-27): the repository stores LF
# for all text files; checkouts translate per core.autocrlf. This ends the
# long-standing ghost-modified files from the mixed CRLF/LF history.
* text=auto

# Binary assets must never be line-ending translated or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
